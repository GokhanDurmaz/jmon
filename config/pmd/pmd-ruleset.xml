<?xml version="1.0" encoding="UTF-8"?>
<!--
  JMon PMD ruleset (PMD 7.9.0, Gradle `pmd` plugin).

  Two-tier thresholds. Gradle's PMD integration cannot fail per-rule or per-
  priority, so every rule below is enforced at the FAILURE threshold. The
  review thresholds are recorded here and in PROJECT_STATUS.md and are
  expected to be applied during code review; failure thresholds are
  deliberately set so that the review threshold crossing alone does not
  break the build.

  Rules that are deliberately NOT enabled:
    - design.ExcessiveMethodLength / ExcessiveClassLength / ExcessiveReturnsCount:
      REMOVED in PMD 7.x. Covered instead by NcssCount (method/class NCSS)
      and Checkstyle FileLength; the return-count thresholds are review-only.
    - design.DataClass / GodClass / CouplingBetweenObjects: overlap with
      architectural rules enforced by ArchUnit; too noisy for a TUI app.
    - design demasiados TooManyMethods: no failure threshold required.
    - performance.ConsecutiveLiteralAppends: percent-history buffers append
      literals intentionally; not material in monitoring hot paths.
    - bestpractices.SystemPrintln: covered by Checkstyle RegexpSinglelineJava.
    - design.LoosePackageCoupling, codestyle category: covered by ArchUnit
      and Checkstyle ImportOrder/naming rules.
    - AvoidCatchingGenericException: intentional broad catch policies exist
      at adapter boundaries (documented per-site in code comments); keeping
      the rule enabled fails the build on legitimate defense-in-depth.
      Documented instead of enforced.
-->
<ruleset name="jmon-standard"
        xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0
                    http://pmd.sourceforge.net/ruleset_2_0_0.xsd">
    <description>JMon enforceable standards ruleset</description>

    <!-- ===== Correctness ===== -->
    <rule ref="category/java/errorprone.xml/EmptyCatchBlock">
        <properties>
            <property name="allowCommentedBlocks" value="true"/>
        </properties>
    </rule>
    <rule ref="category/java/errorprone.xml/BrokenNullCheck"/>
    <rule ref="category/java/errorprone.xml/UnconditionalIfStatement"/>
    <rule ref="category/java/errorprone.xml/DoNotTerminateVM"/>
    <rule ref="category/java/errorprone.xml/AvoidDecimalLiteralsInBigDecimalConstructor"/>
    <rule ref="category/java/design.xml/AvoidThrowingNullPointerException"/>
    <rule ref="category/java/errorprone.xml/UselessOperationOnImmutable"/>
    <rule ref="category/java/errorprone.xml/AvoidDuplicateLiterals">
        <!-- review threshold: 3 duplicates; failure: 4 (default) -->
        <properties>
            <property name="maxDuplicateLiterals" value="4"/>
        </properties>
    </rule>

    <!-- ===== Resource lifecycle / concurrency ===== -->
    <rule ref="category/java/errorprone.xml/CloseResource"/>
    <rule ref="category/java/multithreading.xml/AvoidThreadGroup"/>
    <rule ref="category/java/design.xml/MutableStaticState"/>
    <rule ref="category/java/bestpractices.xml/AvoidPrintStackTrace"/>

    <!-- ===== Hygiene ===== -->
    <rule ref="category/java/bestpractices.xml/UnusedPrivateMethod"/>
    <rule ref="category/java/bestpractices.xml/UnusedPrivateField"/>
    <rule ref="category/java/bestpractices.xml/UnusedLocalVariable"/>
    <rule ref="category/java/bestpractices.xml/PreserveStackTrace"/>
</ruleset>
