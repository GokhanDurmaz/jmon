<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  JMon Checkstyle standard (Checkstyle 10.21.4).

  Two severity tiers:
    - severity "error": these violations FAIL checkstyleMain/checkstyleTest.
    - severity "warning": review-threshold violations. They are reported in
      build/reports/checkstyle/*.html|xml but do not fail the build, because
      Checkstyle cannot fail per-rule.

  Enforcement thresholds enforced as errors:
    - max line length                120
    - max file length                600 lines (review threshold 400 -> warning tier)
    - no tabs, LF line endings, final newline
    - no wildcard imports, ordered/separated import groups
    - one package decl, one top-level class per file
    - brace style K&R, braces required for if/else/for/while/do
    - empty blocks only with an explanatory comment (EmptyBlock option=TEXT)
    - one statement per line, no trailing whitespace
    - no magic numbers in production code (tests exempt; see suppressions.xml)
    - named-check discipline: FallThrough, ModifierOrder, MissingOverride
    - package/type/method/constant/local/member/parameter naming conventions
    - Javadoc required on public types and public methods (presence only)
  -->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="SuppressionFilter">
        <property name="file"
                value="${config_loc}/suppressions.xml"/>
        <property name="optional" value="false"/>
    </module>

    <property name="fileExtensions" value="java"/>

    <module name="NewlineAtEndOfFile">
        <property name="lineSeparator" value="lf"/>
    </module>
    <module name="FileTabCharacter"/>
    <module name="RegexpSingleline">
        <!-- trailing whitespace -->
        <property name="format" value="[\s]+$"/>
        <property name="message" value="Trailing whitespace is prohibited"/>
    </module>

    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="fileExtensions" value="java"/>
    </module>

    <module name="FileLength">
        <!-- review threshold: 400 lines -->
        <property name="max" value="400"/>
        <property name="severity" value="warning"/>
    </module>
    <module name="FileLength">
        <!-- failure threshold: 600 lines -->
        <property name="max" value="600"/>
    </module>

    <module name="TreeWalker">

        <!-- File structure -->
        <module name="PackageDeclaration"/>
        <module name="OneTopLevelClass"/>
        <module name="OuterTypeFilename"/>
        <module name="EmptyLineSeparator">
            <property name="allowMultipleEmptyLines" value="false"/>
            <property name="allowMultipleEmptyLinesInsideClassMembers" value="false"/>
            <property name="tokens" value="IMPORT, CLASS_DEF, ENUM_DEF, INTERFACE_DEF, RECORD_DEF, STATIC_INIT, INSTANCE_INIT, METHOD_DEF"/>
        </module>

        <!-- Imports -->
        <module name="AvoidStarImport"/>
        <module name="ImportOrder">
            <property name="groups" value="/^java\./,/^javax\./,/^(com|net|org|oshi)\./,/^io\.jmon\./"/>
            <property name="ordered" value="true"/>
            <property name="separated" value="true"/>
            <property name="option" value="inflow"/>
        </module>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="IllegalImport">
            <!-- sun.* and similar internal APIs -->
            <property name="illegalPkgs" value="sun, com.sun.crypto"/>
        </module>

        <!-- Whitespace / statements -->
        <module name="OneStatementPerLine"/>
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="braceAdjustment" value="0"/>
            <property name="caseIndent" value="4"/>
            <property name="throwsIndent" value="4"/>
            <property name="arrayInitIndent" value="4"/>
            <property name="lineWrappingIndentation" value="4"/>
        </module>
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
        </module>
        <module name="GenericWhitespace"/>
        <module name="ParenPad"/>
        <module name="NoWhitespaceAfter">
            <property name="tokens" value="INC, DEC"/>
        </module>
        <module name="MethodParamPad"/>
        <module name="OperatorWrap">
            <property name="option" value="nl"/>
        </module>

        <!-- Braces -->
        <module name="LeftCurly"/>
        <!-- K&R cuddling for else/catch/do (incl. `} else if`) -->
        <module name="RightCurly">
            <property name="option" value="same"/>
            <property name="tokens" value="LITERAL_CATCH, LITERAL_ELSE, LITERAL_DO, LITERAL_TRY, LITERAL_FINALLY"/>
        </module>
        <!-- separate-line closing brace for everything else -->
        <module name="RightCurly">
            <property name="option" value="alone_or_singleline"/>
            <property name="tokens" value="LITERAL_WHILE, LITERAL_FOR, METHOD_DEF, CTOR_DEF, LITERAL_SWITCH, STATIC_INIT, INSTANCE_INIT, ENUM_DEF, RECORD_DEF, ANNOTATION_DEF"/>
        </module>
        <module name="NeedBraces"/>
        <module name="EmptyBlock">
            <!-- empty blocks are prohibited unless they carry an explanatory
                 comment, which acts as the local, narrow justification -->
            <property name="option" value="TEXT"/>
            <property name="tokens" value="LITERAL_IF, LITERAL_FOR, LITERAL_WHILE, LITERAL_DO, LITERAL_ELSE, LITERAL_FINALLY, LITERAL_SWITCH, LITERAL_TRY, INSTANCE_INIT, STATIC_INIT"/>
        </module>
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="^(ignored|expected)$"/>
        </module>

        <!-- Named checks / discipline -->
        <module name="FallThrough"/>
        <module name="ModifierOrder"/>
        <module name="MissingOverride"/>
        <module name="UnnecessarySemicolonInEnumeration"/>
        <module name="UpperEll"/>

        <!-- Naming -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="MemberName"/>
        <module name="StaticVariableName"/>
        <module name="ConstantName"/>
        <module name="LocalVariableName"/>
        <module name="ParameterName"/>
        <module name="CatchParameterName"/>
        <module name="LambdaParameterName"/>
        <module name="ClassTypeParameterName"/>
        <module name="MethodTypeParameterName"/>
        <module name="InterfaceTypeParameterName"/>
        <module name="RecordComponentName"/>

        <!-- Documentation: presence only on public API surface -->
        <module name="MissingJavadocType">
            <property name="scope" value="public"/>
        </module>
        <module name="MissingJavadocMethod">
            <property name="scope" value="public"/>
            <property name="allowMissingPropertyJavadoc" value="true"/>
        </module>

        <!-- CLI visibility policy
             RegexpSinglelineJava forbids System.out/err and printStackTrace in
             production code; io.jmon.app.Main is the sanctioned CLI printer
             (suppressions.xml). -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.out\.|System\.err\.|printStackTrace\("/>
            <property name="message" value="Use the logging facade (slf4j/tinylog), not System.out/err/printStackTrace; CLI output belongs to io.jmon.app.Main"/>
        </module>

        <!-- Magic numbers: production only; tests are exempt via
             suppressions.xml (assertion values are expected to be literal). -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value=""/>
            <property name="ignoreHashCodeMethod" value="true"/>
            <property name="ignoreFieldDeclaration" value="false"/>
            <property name="ignoreAnnotation" value="true"/>
        </module>
        <!-- Field-initialization literals MAY bypass MagicNumber only when
             the field is final (i.e. a named constant definition): a
             mutable field initialized to a bare literal is exactly the
             "future configuration knob" defect the policy targets. -->
        <module name="SuppressionXpathSingleFilter">
            <property name="checks" value="MagicNumber"/>
            <property name="query" value="//FIELD_DEF[./MODIFIERS//FINAL]/*//NUM_INT | //FIELD_DEF[./MODIFIERS//FINAL]/*//NUM_LONG | //FIELD_DEF[./MODIFIERS//FINAL]/*//NUM_DOUBLE | //FIELD_DEF[./MODIFIERS//FINAL]/*//NUM_FLOAT"/>
        </module>
        <!-- Per-line documented magic-number exceptions. The comment MUST
             carry a non-empty reason: "magic-exempt: <why>"; the filter
             removes the check only on the same line (influence 0). Used
             only where the literal is intrinsically meaningful (loop
             indexes, zero-width guards, first/last element indexes) and
             a named constant would only restate the arithmetic. -->
        <module name="SuppressWithNearbyCommentFilter">
            <property name="commentFormat" value="magic-exempt: (.+)"/>
            <property name="checkFormat" value="MagicNumberCheck"/>
            <property name="influenceFormat" value="0"/>
        </module>
    </module>
</module>
